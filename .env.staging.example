# Staging environment variables for kew-mobile-v2.
#
# Expo reads variables prefixed with EXPO_PUBLIC_ from process.env at build
# time and inlines them into the JS bundle. The mobile code now prefers
# these over the values baked into app.json's `extra` block.
#
# For OTA staging updates (eas update --branch staging), export these in
# your shell before running the command:
#   export $(cat .env.staging | xargs) && eas update --branch staging --message "..."
#
# For native staging builds (eas build --profile staging), the same values
# are also pinned in eas.json under build.staging.env — keeping both in
# sync is your responsibility. Real values live in those two places (your
# shell + eas.json) and should NEVER be committed.

EXPO_PUBLIC_API_BASE_URL=https://kew-backend-staging.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://axfqrmjjqnklftpomaao.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key
